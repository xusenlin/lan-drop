import { Theme } from "../theme.slint";

export component EmptyState inherits Rectangle {
    VerticalLayout {
        alignment: center; spacing: 12px;
        HorizontalLayout {
            alignment: center;
            Image { source: @image-url("../icons/empty.svg"); width: 144px; height: 108px; image-fit: contain; }
        }
        Text { text: "Your shared space is ready"; color: Theme.empty-title; font-size: 16px; font-weight: 600; horizontal-alignment: center; }
        Text { text: "Drop in the first file and sharing starts here."; color: Theme.muted; font-size: Theme.font-tiny; horizontal-alignment: center; }
    }
}
