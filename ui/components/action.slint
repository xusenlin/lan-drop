import { Theme } from "../theme.slint";
import { Icon } from "icon.slint";

export component Action inherits Rectangle {
    in property <string> label;
    in property <image> icon;
    in property <bool> primary: false;
    in property <bool> quiet: false;
    in property <bool> on-dark: false;
    in property <bool> enabled: true;
    callback clicked();

    private property <color> ink: !root.enabled ? Theme.action-disabled-text
        : root.on-dark ? #f1f8f3 : root.primary ? white : Theme.action-text;
    height: 38px;
    preferred-width: 88px;
    min-width: content.min-width;
    border-radius: 9px;
    border-width: focus.has-focus && root.enabled ? 2px : 1px;
    border-color: focus.has-focus && root.enabled ? #8cb8a4
        : root.on-dark ? #ffffff30 : root.quiet || root.primary ? transparent : Theme.border;
    background: !root.enabled ? Theme.action-disabled-bg
        : root.on-dark ? (touch.has-hover ? #ffffff25 : #ffffff10)
        : root.primary ? (touch.pressed ? #115239 : touch.has-hover ? Theme.brand-hover : Theme.brand)
        : touch.has-hover ? Theme.action-hover-bg : root.quiet ? transparent : Theme.action-bg;
    forward-focus: focus;
    accessible-role: button;
    accessible-label: root.label;
    accessible-enabled: root.enabled;
    accessible-action-default => { if root.enabled { root.clicked(); } }

    content := HorizontalLayout {
        padding-left: 10px; padding-right: 10px;
        alignment: center; spacing: 7px;
        if root.icon.width > 0: Icon { source: root.icon; ink: root.ink; width: 16px; }
        Text {
            text: root.label; color: root.ink; font-size: Theme.font-tiny;
            font-weight: 600; vertical-alignment: center;
        }
    }
    touch := TouchArea { enabled: root.enabled; mouse-cursor: pointer; clicked => { root.clicked(); } }
    focus := FocusScope {
        width: 0px; enabled: root.enabled;
        key-pressed(event) => {
            if event.text == " " || event.text == "\n" { root.clicked(); return accept; }
            return reject;
        }
    }
}
