import { ListView } from "std-widgets.slint";
import { Theme } from "../theme.slint";
import { Action } from "action.slint";
import { Icon } from "icon.slint";
import { FileRowItem } from "file_row.slint";
import { EmptyState } from "empty_state.slint";
import { FileRow } from "../types.slint";

export component SharedPanel inherits Rectangle {
    in property <int> file-count;
    in property <string> total-size;
    in property <[FileRow]> files;
    callback refresh(); callback open-folder();
    callback copy-text(string); callback open-file(string); callback delete-file(string);

    background: Theme.card-bg;
    border-radius: 16px;
    border-width: 1px; border-color: Theme.border;

    VerticalLayout {
        padding: 22px; spacing: 18px;
        HorizontalLayout {
            height: 42px; spacing: 12px;
            VerticalLayout {
                alignment: center;
                Rectangle {
                    width: 40px; height: 40px; border-radius: 12px; background: #edf4ed;
                    Icon { source: @image-url("../icons/grid.svg"); x: 10px; y: 10px; width: 20px; height: 20px; }
                }
            }
            VerticalLayout {
                spacing: 5px; alignment: center;
                Text { text: "Shared space"; font-size: Theme.font-heading; font-weight: 700; color: Theme.heading; }
                Text {
                    text: root.file-count + (root.file-count == 1 ? " file · " : " files · ") + root.total-size;
                    color: Theme.muted; font-size: Theme.font-micro;
                }
            }
            VerticalLayout {
                alignment: center;
                Action { width: 100px; height: 32px; label: "Refresh"; icon: @image-url("../icons/refresh.svg"); quiet: true; clicked => { root.refresh(); } }
            }
        }
        Rectangle { height: 1px; background: Theme.border; }
        HorizontalLayout {
            height: 16px;
            Text { text: "Name / modified"; color: Theme.muted; font-size: Theme.font-micro; }
            Text { text: "Syncs every 2 seconds"; horizontal-alignment: right; color: Theme.muted; font-size: Theme.font-micro; }
        }
        if root.file-count == 0: EmptyState { }
        if root.file-count > 0: ListView {
            for file in root.files: Rectangle {
                height: 84px;
                FileRowItem {
                    y: 0; width: parent.width; height: 76px;
                    file: file;
                    copy-text(name) => { root.copy-text(name); }
                    open-file(name) => { root.open-file(name); }
                    delete-file(name) => { root.delete-file(name); }
                }
            }
        }
        Rectangle { height: 1px; background: Theme.border; }
        HorizontalLayout {
            height: 34px; spacing: 10px;
            Text { text: "Files are stored on this computer"; color: Theme.muted; font-size: Theme.font-micro; vertical-alignment: center; }
            Action { width: 168px; height: 34px; label: "Open data folder"; icon: @image-url("../icons/folder.svg"); quiet: true; clicked => { root.open-folder(); } }
        }
    }
}
